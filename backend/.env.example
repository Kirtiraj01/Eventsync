# Environment
NODE_ENV=production

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/clubhub

# Server configuration
PORT=5050
CLIENT_URL=http://localhost:5180
BASE_URL=http://localhost:5050

# Auth secrets (use two DIFFERENT long, cryptographically random strings)
JWT_SECRET=replace_with_a_long_random_string_for_club_member_auth
TICKET_SECRET=replace_with_a_different_long_random_string_for_tickets

# JWT expiry
JWT_EXPIRES_IN=7d
TICKET_EXPIRES_IN=60d

# Email (Nodemailer + SMTP). Leave blank to fall back to safe console logging for testing/local dev.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="EventSync <no-reply@eventsync.app>"

# Public app verify base (used inside certificate QR + verification links)
PUBLIC_APP_URL=http://localhost:5180

# Optional: Path to custom Chromium executable (useful in Docker/Linux production)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
